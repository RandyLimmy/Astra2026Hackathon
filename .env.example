# Copy to .env and fill in your one OpenAI API key. Never commit the real key.
# The investigation command reads this file; physics-only commands do not.
OPENAI_API_KEY=

# Model IDs, NOT additional API keys. The adapter uses OPENAI_API_KEY
# for either model, subject to the API project's model access.
ASTRA_MODEL=gpt-6-astra
ASTRA_REASONING_EFFORT=medium

# Optional: only needed for the planned Astra-versus-Sol comparison.
# Leave this commented out while building an Astra-only loop.
# SOL_MODEL=gpt-5.6-sol
