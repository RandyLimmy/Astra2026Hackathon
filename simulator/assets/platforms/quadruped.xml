        <geom type="sphere" size="0.038" mass="0.10" rgba="0.14 0.18 0.23 1" contype="0" conaffinity="0"/>
        <body name="FL_upper">
          <joint name="FL_hip_pitch" axis="0 1 0" range="-1.3 1.5"/>
          <geom class="limb" name="FL_thigh" fromto="0 0 0 0 0 -0.22" mass="0.28"/>
